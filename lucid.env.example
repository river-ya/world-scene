# Copy to lucid.env. Keep this environment separate from FlashWorld.
export LUCID_DATA_ROOT=/shared/your_user/world-scene-data
export LUCID_ENV="$LUCID_DATA_ROOT/envs/world-scene-lucid-0.7.0"
export LUCID_PARTITION=your_gpu_partition
export LUCID_ACCOUNT=
export LUCID_QOS=
export LUCID_NODE=your_4090_node
export LUCID_CPUS=8 LUCID_MEM=64G LUCID_BUILD_JOBS=2
