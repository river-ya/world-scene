# Copy to local.env. Use a shared data filesystem visible on compute nodes.
export DATA_ROOT=/shared/your_user/world-scene-data
export SCENE_ENV="$DATA_ROOT/envs/world-scene-0.10.2"
# To reuse an already validated FlashWorld environment, change SCENE_ENV above.
export PARTITION=your_gpu_partition
export ACCOUNT=
export QOS=
# Select a node with RTX 4090; leave empty only if the partition is homogeneous.
export NODE=your_4090_node
export CPUS=8 MEM=96G MAX_JOBS=2
